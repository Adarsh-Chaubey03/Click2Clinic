PORT=3000
MONGODB_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_API_KEY=
CLOUDINARY_CLOUD_API_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
CURRENCY=$
HUGGING_API_KEY=
# Optional text-generation model supported by the configured Hugging Face provider
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_FALLBACK_MODELS=
# Optional router overrides
HF_ROUTER_ORIGIN=https://router.huggingface.co
HF_INFERENCE_BASE=https://router.huggingface.co/hf-inference
HF_ENABLE_LEGACY_INFERENCE=false
RAZORPAY_ID=
RAZORPAY_SECRET=
# RAG Chatbot - Embedding model (separate from text-generation)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
